{
  "name": "shelf",
  "version": "0.1.0",
  "description": "An offline file tidier. Rules sort what they can; a small open-weight model sorts the rest. Nothing is deleted, and nothing moves until you say so.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "shelf": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
